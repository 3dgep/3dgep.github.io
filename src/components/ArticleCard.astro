---
// Home page card for an article: thumbnail, badge (e.g. "Lesson 1"), title, description and year.
// Styled like Starlight's LinkCard (border, radius, shadow, hover) with Starlight's Badge.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { Badge } from '@astrojs/starlight/components';

interface Props {
	href: string;
	title: string;
	description: string;
	image: ImageMetadata;
	/** Short label above the title, e.g. "Lesson 2". */
	badge?: string;
	/** Year the article was first published. */
	year?: number;
	/** CSS object-position for the thumbnail crop (default: center). */
	focus?: string;
}

const { href, title, description, image, badge, year, focus = 'center' } = Astro.props;
---

<a class="article-card not-content" href={href}>
	<div class="thumb">
		<Image src={image} alt="" widths={[320, 480, 640]} sizes="(max-width: 50rem) 100vw, 20rem" style={`object-position: ${focus}`} />
	</div>
	<div class="body">
		{badge && <Badge text={badge} size="small" />}
		<span class="title">{title}</span>
		<span class="description">{description}</span>
		{year && <span class="meta">{year}</span>}
	</div>
</a>

<style>
	/* Same look as Starlight's LinkCard. */
	.article-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		height: 100%;
		color: inherit;
		text-decoration: none;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		box-shadow: var(--sl-shadow-sm);
	}
	.article-card:hover {
		background: var(--sl-color-gray-7, var(--sl-color-gray-6));
		border-color: var(--sl-color-gray-2);
	}
	.article-card:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.thumb {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--sl-color-gray-6);
		border-bottom: 1px solid var(--sl-color-gray-5);
	}
	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.body {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.5rem;
		padding: 1rem;
		flex: 1;
	}
	.title {
		color: var(--sl-color-white);
		font-weight: 600;
		font-size: var(--sl-text-lg);
		line-height: var(--sl-line-height-headings);
	}
	.description {
		color: var(--sl-color-gray-3);
		line-height: 1.5;
	}
	.meta {
		margin-top: auto;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
</style>
